rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Kanal yükleme izinleri: yalnızca sunucu (GitHub Actions) okur, uygulama asla göremez.
    match /secrets/{id} {
      allow read, write: if false;
    }

    // Klon ses örnekleri: yalnızca sunucu okur/yazar.
    match /voices/{id} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /meta/{id} {
      allow read: if isAdmin();
    }

    // Uygulama kanal bilgilerini okur, yalnızca ayarlarını değiştirebilir.
    match /channels/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings']);
    }

    // Uygulama videoları izler; hatalı olanı "yeniden dene" diye işaretleyebilir.
    match /videos/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retry']);
    }

    // Kanal karakterinin kayıtlı yüzü; uygulama gösterir ve yalnızca "yeniden çiz" isteyebilir.
    match /characters/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['regenerate']);
    }

    match /events/{id} {
      allow read, delete: if isAdmin();
    }

    match /devices/{id} {
      allow read, write: if isAdmin();
    }
  }
}
