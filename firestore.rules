rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Kanal yükleme izinleri: yalnızca sunucu (GitHub Actions) okur, uygulama asla göremez.
    // Uygulama, cihaz koduyla bağladığı kanalın iznini yalnızca yazabilir (okuyamaz).
    match /secrets/{id} {
      allow read, delete: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['refreshToken', 'client', 'updatedAt'])
        && request.resource.data.client == 'tv'
        && request.resource.data.refreshToken is string;
    }

    // Klon ses örnekleri: yalnızca sunucu okur/yazar.
    match /voices/{id} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /meta/{id} {
      allow read: if isAdmin();
    }

    // Uygulama kanal bilgilerini okur ve ayarlarını değiştirir; uygulamadan bağlanan kanalın kaydını açar/yeniler.
    match /channels/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'thumbnail', 'connectedAt', 'needsReconnect', 'settings', 'fromApp']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['settings', 'title', 'thumbnail', 'connectedAt', 'needsReconnect', 'fromApp']);
    }

    // Uygulama videoları izler; hatalı olanı "yeniden dene" diye işaretleyebilir.
    match /videos/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retry']);
    }

    // Kanal karakterinin kayıtlı yüzü; uygulama gösterir ve yalnızca "yeniden çiz" isteyebilir.
    match /characters/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['regenerate']);
    }

    // Video başına performans ve teşhis (optimizasyon); yalnızca sunucu yazar.
    match /perf/{id} {
      allow read: if isAdmin();
    }
    // Instagram / TikTok / Facebook istatistikleri ve rakip analizleri (sunucu yazar, uygulama okur)
    match /sosyal/{id} {
      allow read: if isAdmin();
    }
    match /rakip/{id} {
      allow read: if isAdmin();
      // Uygulamadan elle rakip ekleme: sadece rakipler listesi
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['elle']);
    }

    match /events/{id} {
      allow read, delete: if isAdmin();
    }

    match /devices/{id} {
      allow read, write: if isAdmin();
    }
  }
}
