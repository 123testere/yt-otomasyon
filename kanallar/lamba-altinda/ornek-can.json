      "narration": "Dünyanın en ağır çanı bir kez bile çalmadı. Sence neden? Çatladı mı, yoksa hiç asılamadı mı? Cevap sonda.",
      "cizim": "const b=eo(pr(u,0,.7));ctx.save();ctx.translate(500,330);ctx.rotate(Math.sin(T*1.6)*.035*b);ctx.translate(-500,-330);ink([[425,143],[385,255],[363,405],[300,505],[700,505],[638,405],[615,255],[575,143]],{close:true,fill:'#B8893B',w:8,seed:10,pp:b});ink(ell(500,115,33,30,18),{close:true,w:7,seed:11,pp:eo(pr(u,.1,.5))});ink(ln([345,435],[655,435],12),{w:5,seed:12,pp:eo(pr(u,.3,.8))});ctx.restore();const sor=w('neden');const q=eo(pr(u,sor,sor+.5));for(let i=0;i<3;i++){const a=q*(.6+.4*Math.sin(T*4+i));txt('?',260+i*240,120+30*Math.sin(T*2+i),90,{c:K.ak,a});}const c1=w('Çatladı'),c2=w('asılamadı');ink(ln([470,160],[520,290],6),{w:5,c:K.bordo,seed:14,pp:eo(pr(u,c1,c1+.5))});ink(ln([500,60],[500,0],4),{w:6,seed:15,pp:eo(pr(u,c2,c2+.4)),dash:[10,10]});etk('ağırlık?',620,60,eo(pr(u,c2,c2+.5)),{size:40});etk('Çar Çanı · Moskova',500,640,eo(pr(u,.3,.9)),{size:48});"
    },
    {
